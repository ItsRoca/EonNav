<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Nombre -->
        <AutoCompleteTextView
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre Pokémon"/>


        <!-- Habilidad -->
        <AutoCompleteTextView
            android:id="@+id/spAbility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ability"/>

        <!-- Movimientos -->
        <TextView
            android:text="Movimientos"
            android:layout_marginTop="16dp"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"/>

        <AutoCompleteTextView android:id="@+id/move1"
            android:hint="Movimiento 1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <AutoCompleteTextView android:id="@+id/move2"
            android:hint="Movimiento 2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <AutoCompleteTextView android:id="@+id/move3"
            android:hint="Movimiento 3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <AutoCompleteTextView android:id="@+id/move4"
            android:hint="Movimiento 4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Naturaleza -->
        <Spinner
            android:id="@+id/spNature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Boton guardar -->
        <Button
            android:id="@+id/btnSavePokemon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar"
            android:layout_marginTop="20dp"/>

    </LinearLayout>
</ScrollView>
